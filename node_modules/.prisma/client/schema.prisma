generator erd {
  provider = "prisma-erd-generator"
}

// ==========================================
// Complete & Unified Schema
//
// Refactored for clarity, consistency, and
// modern best practices.
// ==========================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// --- Enums & Global Types ---
// ==========================================

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
  PENDING
}

enum UserType {
  REGULAR
  ADMIN
  FACILITATOR
  SUPERVISOR
}

enum TokenType {
  SESSION
  API
  PASSWORD_RESET
}

enum ClipType {
  VIDEO
  TEXT
  ASSIGNMENT
  QUIZ
  EXERCISE
  DOCUMENT
}

enum ContentType {
  VIDEO
  DOCUMENT
  TEXT
  ASSIGNMENT
  QUIZ
  EXERCISE
  COURSE
  CLIP
}

enum CourseLayout {
  MULTI_CLIP
  SINGLE_PAGE
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_RESPONSE
  FILL_IN_THE_BLANK
  ESSAY
  VIDEO_RESPONSE
}

enum FeedbackType {
  STAR_RATING
  MULTIPLE_CHOICE
  TEXT_INPUT
}

enum ProductType {
  COURSE
  LEARNING_PATH
  SUBSCRIPTION
  SERVICE
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum Platform {
  WEB
  IOS
  ANDROID
  WINDOWS
}

enum AnalyticsJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CronFrequency {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

// ==========================================
// --- Core & Identity ---
// User, Organization, Roles, Auth
// ==========================================

model User {
  id               Int          @id @default(autoincrement())
  employeeId       String?      @unique @map("emp_id")
  externalId       String?      @unique @map("uniqid")
  username         String       @unique
  email            String       @unique
  password         String
  salt             String
  firstName        String
  lastName         String?
  type             UserType     @default(REGULAR)
  isEmailVerified  Boolean      @default(false)
  mobileNumber     String?
  isMobileVerified Boolean      @default(false)
  photoUrl         String?
  thumbnailUrl     String?
  dateOfBirth      DateTime?
  language         String       @default("en")
  timezone         String?      @default("UTC")
  lastLoginAt      DateTime?
  status           Status       @default(ACTIVE)
  organizationId   Int
  organization     Organization @relation(fields: [organizationId], references: [id])
  managerId        Int?
  manager          User?        @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates     User[]       @relation("ManagerSubordinates")
  departmentId     Int?
  department       Department?  @relation(fields: [departmentId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sessions                  Session[]
  refreshTokens             RefreshToken[]
  roleAssignments           RoleAssignment[]
  userRoles                 UserRole[]
  assignmentSubmissions     AssignmentSubmission[]
  courseEnrollments         CourseEnrollment[]
  clipProgress              ClipProgress[]
  discussions               Discussion[]
  discussionPosts           DiscussionPost[]
  documentViews             DocumentUser[]
  quizAttempts              QuizAttempt[]
  courseFeedbackResponses   CourseFeedbackResponse[]
  userOrgProfile            UserOrgProfile?
  orders                    Order[]
  analyticsEvents           AnalyticsEvent[]
  batchMembers              BatchMember[]
  batchCaseStudySubmissions BatchCaseStudySubmission[]
  resume                    Resume?
  userIncentives            UserIncentive[]
  microlmsContentStatuses   MicrolmsContentUserStatus[]
  microlmsQuizAttempts      MicrolmsQuizAttempt[]
  microlmsCalendarEvents    MicrolmsCalendarEvent[]
  discussionPostLikes       DiscussionPostLike[]
  courseComponentProgress   CourseComponentProgress[]
  facilitatedBatches        Batch[]                     @relation("BatchFacilitator")

  @@map("users")
}

model Organization {
  id            Int      @id @default(autoincrement())
  name          String
  logoUrl       String?
  websiteUrl    String?
  address       String?
  contactPerson String?
  contactEmail  String?
  slug          String?  @unique
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users                       User[]
  divisions                   Division[]
  roles                       Role[]
  campaigns                   Campaign[]
  competencies                Competency[]
  proficiencyLevels           ProficiencyLevel[]
  orgLevels                   OrgLevel[]
  designations                Designation[]
  learningPaths               LearningPath[]
  cronJobs                    CronJob[]
  dashboardFeatureAssignments DashboardFeatureAssignment[]
  jicedRoles                  JicedRole[]
  jicedCandidates             JicedCandidate[]
  batches                     Batch[]
  microlmsQuestions           MicrolmsQuestion[]
  microlmsFeatureAssignments  MicrolmsFeatureOrgAssignment[]
  microlmsContent             MicrolmsContent[]
  microlmsQuizzes             MicrolmsQuiz[]
  microlmsProductCategories   MicrolmsProductCategory[]
  courseOrganizationLinks     CourseOrganizationLink[]
  discussions                 Discussion[]

  @@map("organisation")
}

model Division {
  id             Int          @id @default(autoincrement())
  name           String
  shortName      String?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments                 Department[]
  roleAssignments             RoleAssignment[]
  userOrgProfiles             UserOrgProfile[]
  learningPathRoleAssignments LearningPathRoleAssignment[]

  @@unique([organizationId, name])
  @@map("organisation_divisions")
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String
  divisionId Int
  division   Division @relation(fields: [divisionId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users           User[]
  userOrgProfiles UserOrgProfile[]

  @@unique([divisionId, name])
  @@map("organisation_departments")
}

model Role {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments                 RoleAssignment[]
  userRoles                   UserRole[]
  learningPathRoleAssignments LearningPathRoleAssignment[]

  @@unique([organizationId, name])
  @@map("organisation_roles")
}

model RoleAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  roleId     Int
  role       Role     @relation(fields: [roleId], references: [id])
  divisionId Int
  division   Division @relation(fields: [divisionId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, roleId, divisionId])
  @@map("admin_division_role_map")
}

// Preserve existing simple role system
model UserRole {
  id     String @id @default(cuid())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  type      TokenType
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("session_tokens")
}

// Preserve existing JWT authentication system
model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     Int
  expiresAt  DateTime
  deviceInfo String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// --- Learning Content ---
// Course, Clip, Video, Document
// ==========================================

model Course {
  id                   Int          @id @default(autoincrement())
  name                 String       @map("course_name")
  subtitle             String?
  synopsis             String?
  description          String?
  targetAudience       String?      @map("whoisthisfor")
  learningObjectives   String?
  skillsLearned        String?      @map("skills")
  prerequisites        String?      @map("prerequisite")
  thumbnailUrl         String?      @map("thumbimage")
  promotionalVideoUrl  String?      @map("promotional_video")
  sampleCertificateUrl String?      @map("sample_certificate")
  durationInMinutes    Int          @default(0) @map("course_duration")
  totalHours           Int          @default(0) @map("total_hours")
  totalPoints          Int          @default(0) @map("course_points")
  slug                 String       @unique
  layout               CourseLayout @default(MULTI_CLIP) @map("course_layout")
  isPublished          Boolean      @default(true) @map("publish")
  showInCatalogue      Boolean      @default(false)
  version              Int          @default(1)
  status               Status       @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  clips              Clip[]
  assignments        Assignment[]
  courseObjectives   CourseObjective[]
  courseFeatures     CourseFeature[]
  courseRoadmapSteps CourseRoadmapStep[]
  courseHowItWorks   CourseHowItWorks[]
  relatedCourses     RelatedCourse[]           @relation("course")
  relatedTo          RelatedCourse[]           @relation("relatedCourse")
  categories         CourseCategoryLink[]
  organizations      CourseOrganizationLink[]
  enrollments        CourseEnrollment[]
  translations       CourseTranslation[]
  feedbackForms      CourseFeedbackForm[]
  quizzes            Quiz[]
  progressComponents CourseProgressComponent[]
  cronJobs           CronJob[]
  batches            Batch[]
  scormPackages      ScormPackage[]
  competencyLinks    CourseCompetency[]
  appViewMetatags    AppViewMetatag[]

  @@map("courses")
}

model Clip {
  id                Int      @id @default(autoincrement())
  title             String   @map("clip_title")
  description       String?
  type              ClipType @map("clip_type")
  sequence          Int      @default(0) @map("sequence_no")
  points            Int      @default(0) @map("clip_points")
  durationInSeconds Int      @default(0) @map("clip_duration")
  slug              String
  status            Status   @default(ACTIVE)
  courseId          Int
  course            Course   @relation(fields: [courseId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contentSequence ContentSequence[]
  highlights      ClipHighlight[]
  progress        ClipProgress[]
  assignments     Assignment[]
  quizzes         Quiz[]

  @@index([courseId])
  @@map("clips")
}

model ContentSequence {
  id          Int         @id @default(autoincrement())
  clipId      Int
  clip        Clip        @relation(fields: [clipId], references: [id])
  contentType ContentType
  contentId   Int
  sequence    Int         @default(0)
  level       Int         @default(1)
  status      Status      @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([clipId, sequence])
  @@map("content_sequence")
}

model Video {
  id                Int      @id @default(autoincrement())
  title             String   @map("video_title")
  description       String?  @map("video_description")
  thumbnailUrl      String?  @map("video_thumbimage")
  durationInSeconds Int      @default(0) @map("video_duration")
  tags              String?  @map("video_tags")
  points            Int      @default(0) @map("video_points")
  isPublished       Boolean  @default(true) @map("publish")
  status            Status   @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sources   VideoSource[]
  subtitles Subtitle[]
  quizzes   VideoQuizLink[]

  @@map("videos")
}

model VideoQuizLink {
  id                 Int      @id @default(autoincrement())
  videoId            Int
  video              Video    @relation(fields: [videoId], references: [id])
  quizId             Int
  quiz               Quiz     @relation(fields: [quizId], references: [id])
  timestampInSeconds Int      @map("quiz_video_duration")
  status             Status   @default(ACTIVE)
  createdAt          DateTime @default(now())

  @@unique([videoId, quizId])
  @@map("video_quizes")
}

model VideoSource {
  id        Int      @id @default(autoincrement())
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id])
  url       String
  language  String   @default("en")
  format    String
  quality   String
  sizeInMb  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("videos_urls")
}

model Subtitle {
  id        Int      @id @default(autoincrement())
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id])
  language  String
  label     String
  url       String
  createdAt DateTime @default(now())

  @@map("video_subtitles")
}

model Document {
  id              Int      @id @default(autoincrement())
  title           String
  url             String
  requiresConsent Boolean  @default(false) @map("document_consent")
  isPublished     Boolean  @default(true) @map("publish")
  status          Status   @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  translations DocumentTranslation[]
  views        DocumentUser[]

  @@map("documents")
}

model ContentCategory {
  id          Int     @id @default(autoincrement())
  name        String  @map("title")
  description String?
  imageUrl    String?
  language    String  @default("en")

  courses CourseCategoryLink[]

  @@map("category")
}

model CourseCategoryLink {
  courseId   Int
  course     Course          @relation(fields: [courseId], references: [id])
  categoryId Int
  category   ContentCategory @relation(fields: [categoryId], references: [id])

  @@id([courseId, categoryId])
  @@map("category_course")
}

model CourseOrganizationLink {
  courseId       Int
  course         Course       @relation(fields: [courseId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@id([courseId, organizationId])
  @@map("courses_organisations")
}

model RelatedCourse {
  courseId        Int
  course          Course @relation("course", fields: [courseId], references: [id])
  relatedCourseId Int
  relatedCourse   Course @relation("relatedCourse", fields: [relatedCourseId], references: [id])
  sortOrder       Int    @default(0)

  @@id([courseId, relatedCourseId])
  @@map("courses_related")
}

model CourseObjective {
  id        Int    @id @default(autoincrement())
  objective String
  sortOrder Int    @default(0)
  courseId  Int
  course    Course @relation(fields: [courseId], references: [id])

  @@map("courses_objectives")
}

model CourseFeature {
  id       Int    @id @default(autoincrement())
  feature  String @map("feature_txt")
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  @@map("course_features")
}

model CourseRoadmapStep {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @map("desc")
  tag         String?
  courseId    Int
  course      Course  @relation(fields: [courseId], references: [id])

  @@map("course_roadmap")
}

model CourseHowItWorks {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @map("desc")
  imageUrl    String? @map("image")
  courseId    Int
  course      Course  @relation(fields: [courseId], references: [id])

  @@map("course_howitworks")
}

model ClipHighlight {
  id        Int    @id @default(autoincrement())
  highlight String
  sortOrder Int    @default(0)
  clipId    Int
  clip      Clip   @relation(fields: [clipId], references: [id])

  @@map("clips_highlights")
}

model AppViewMetatag {
  id              Int     @id @default(autoincrement())
  url             String?
  pageTitle       String?
  metaKeywords    String?
  metaDescription String?
  courseId        Int?
  course          Course? @relation(fields: [courseId], references: [id])
  contentType     String?
  contentId       Int?

  @@map("app_views_metatags")
}

model CourseTranslation {
  courseId           Int
  course             Course  @relation(fields: [courseId], references: [id])
  language           String
  name               String?
  subtitle           String?
  synopsis           String?
  description        String?
  targetAudience     String?
  learningObjectives String?
  skillsLearned      String?

  @@id([courseId, language])
  @@map("courses_translation")
}

model DocumentTranslation {
  documentId Int
  document   Document @relation(fields: [documentId], references: [id])
  language   String
  title      String?
  url        String?

  @@id([documentId, language])
  @@map("documents_translation")
}

model CourseProgressComponent {
  id                      Int         @id @default(autoincrement())
  courseId                Int
  course                  Course      @relation(fields: [courseId], references: [id])
  componentType           ContentType
  componentId             Int
  points                  Int         @default(0)
  weightage               Int         @default(0)
  prerequisiteComponentId Int?
  status                  Status      @default(ACTIVE)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  userProgress CourseComponentProgress[]

  @@unique([courseId, componentType, componentId])
  @@map("course_progress_components")
}

model CourseComponentProgress {
  userId          Int
  user            User                    @relation(fields: [userId], references: [id])
  componentId     Int
  component       CourseProgressComponent @relation(fields: [componentId], references: [id])
  isStarted       Boolean                 @default(false)
  isCompleted     Boolean                 @default(false)
  progressPercent Int                     @default(0)
  pointsAchieved  Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@id([userId, componentId])
  @@map("user_progress_components")
}

// ==========================================
// --- Assessments & Interactions ---
// Quiz, Assignment, Discussion, Feedback
// ==========================================

model Quiz {
  id                 Int      @id @default(autoincrement())
  title              String   @map("quiz_name")
  courseId           Int?
  course             Course?  @relation(fields: [courseId], references: [id])
  clipId             Int?
  clip               Clip?    @relation(fields: [clipId], references: [id])
  weightage          Float    @default(0)
  passThreshold      Int      @default(0)
  maxAttempts        Int      @default(1)
  timeLimitInMinutes Int      @default(0)
  showAnalysis       Boolean  @default(true)
  randomizeQuestions Boolean  @default(true) @map("is_randomize")
  isPublished        Boolean  @default(true) @map("publish")
  status             Status   @default(ACTIVE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  questions      QuizQuestion[]
  attempts       QuizAttempt[]
  videoQuizLinks VideoQuizLink[]

  @@map("quiz")
}

model QuizQuestion {
  id                 Int          @id @default(autoincrement())
  quizId             Int
  quiz               Quiz         @relation(fields: [quizId], references: [id])
  text               String       @map("question")
  type               QuestionType @default(MULTIPLE_CHOICE)
  points             Float        @default(1) @map("question_points")
  sequence           Int          @default(0) @map("sequence_no")
  supportingVideoUrl String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  options QuizOption[]
  answers QuizAnswer[]

  @@map("quiz_questions")
}

model QuizOption {
  id         Int          @id @default(autoincrement())
  questionId Int
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  text       String       @map("answer")
  isCorrect  Boolean      @default(false)
  imageUrl   String?
  sequence   Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  selectedAnswers QuizAnswer[]

  @@map("quiz_options")
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  score       Float?
  isCompleted Boolean   @default(false)

  answers QuizAnswer[]

  @@index([userId, quizId])
  @@map("quiz_user_status")
}

model QuizAnswer {
  id               Int          @id @default(autoincrement())
  attemptId        Int
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id])
  questionId       Int
  question         QuizQuestion @relation(fields: [questionId], references: [id])
  selectedOptionId Int?
  selectedOption   QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responseText     String?
  pointsAchieved   Float        @default(0)
  createdAt        DateTime     @default(now())

  @@unique([attemptId, questionId])
  @@map("quiz_users")
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  isPublished Boolean  @default(false) @map("publish")
  status      Status   @default(ACTIVE)
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id])
  clipId      Int?
  clip        Clip?    @relation(fields: [clipId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions  AssignmentSubmission[]
  translations AssignmentTranslation[]

  @@map("assignments")
}

model AssignmentSubmission {
  id            Int        @id @default(autoincrement())
  assignmentId  Int
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  userId        Int
  user          User       @relation(fields: [userId], references: [id])
  submittedUrl  String?    @map("assignment_url")
  submittedText String?
  score         Int?       @default(0) @map("facilitator_points")
  comments      String?    @map("facilitator_comments")
  gradedAt      DateTime?  @map("feedback_date")
  submittedAt   DateTime   @default(now()) @map("createddt")
  updatedAt     DateTime   @updatedAt @map("lupdndt")

  @@map("assignments_users")
}

model AssignmentTranslation {
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  language     String
  title        String?
  description  String?

  @@id([assignmentId, language])
  @@map("assignments_translation")
}

model Discussion {
  id             Int          @id @default(autoincrement())
  topic          String
  description    String?
  isPublished    Boolean      @default(true)
  status         Status       @default(ACTIVE)
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  contentType    ContentType?
  contentId      Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  posts DiscussionPost[]

  @@map("discussions")
}

model DiscussionPost {
  id           Int              @id @default(autoincrement())
  text         String           @map("comment_text")
  discussionId Int
  discussion   Discussion       @relation(fields: [discussionId], references: [id])
  authorId     Int
  author       User             @relation(fields: [authorId], references: [id])
  parentId     Int?
  parent       DiscussionPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      DiscussionPost[] @relation("PostReplies")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  likes DiscussionPostLike[]

  @@map("discussions_comments")
}

model DiscussionPostLike {
  postId    Int
  post      DiscussionPost @relation(fields: [postId], references: [id])
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())

  @@id([postId, userId])
  @@map("discussions_comments_likes")
}

model CourseFeedbackForm {
  id          Int     @id @default(autoincrement())
  title       String  @map("feedback_title")
  description String?
  courseId    Int     @unique
  course      Course  @relation(fields: [courseId], references: [id])

  questions CourseFeedbackQuestion[]

  @@map("course_feedback")
}

model CourseFeedbackQuestion {
  id       Int                @id @default(autoincrement())
  formId   Int
  form     CourseFeedbackForm @relation(fields: [formId], references: [id])
  text     String             @map("question")
  type     FeedbackType
  sequence Int                @default(0)

  options   CourseFeedbackOption[]
  responses CourseFeedbackResponse[]

  @@map("course_feedback_questions")
}

model CourseFeedbackOption {
  id          Int                    @id @default(autoincrement())
  questionId  Int
  question    CourseFeedbackQuestion @relation(fields: [questionId], references: [id])
  value       String                 @map("option_value")
  description String?
  sortOrder   Int                    @default(0)

  selectedResponses CourseFeedbackResponse[]

  @@map("course_feedback_options")
}

model CourseFeedbackResponse {
  id               Int                    @id @default(autoincrement())
  questionId       Int
  question         CourseFeedbackQuestion @relation(fields: [questionId], references: [id])
  userId           Int
  user             User                   @relation(fields: [userId], references: [id])
  selectedOptionId Int?
  selectedOption   CourseFeedbackOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responseText     String?                @map("comments")
  submittedAt      DateTime               @default(now())

  @@map("course_feedback_users")
}

// ==========================================
// --- E-commerce & Campaigns ---
// Product, Order, Campaign
// ==========================================

model Product {
  id          Int         @id @default(autoincrement())
  name        String      @map("product")
  type        ProductType @map("product_type")
  description String?     @map("remark")
  price       Float
  referenceId Int
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaigns  CampaignProduct[]
  orderItems OrderItem[]

  @@map("kl_products")
}

model Campaign {
  id              Int           @id @default(autoincrement())
  name            String        @map("campaign_name")
  url             String        @map("campaign_url")
  promoCode       String?       @unique
  discountPercent Int           @map("discount")
  isActive        Boolean       @map("is_active")
  startDate       DateTime?
  endDate         DateTime?
  organizationId  Int?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  products CampaignProduct[]

  @@map("campaigns")
}

model CampaignProduct {
  campaignId   Int
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  discountRate Float?

  @@id([campaignId, productId])
  @@map("campaign_reference_products")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderCode   String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Float
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
  paymentLogs PaymentGatewayLog[]
  invoice     Invoice?

  @@map("users_orders")
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id])
  productId       Int
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int     @default(1)
  priceAtPurchase Float   @map("price")
  discountCode    String?

  @@map("users_orders_details")
}

model Invoice {
  id          Int      @id @default(autoincrement())
  invoiceCode String   @unique @map("unique_invoice_id")
  orderId     Int      @unique
  order       Order    @relation(fields: [orderId], references: [id])
  fileUrl     String?  @map("invoice_copy")
  issuedAt    DateTime @default(now())

  @@map("users_orders_invoice")
}

model PaymentGatewayLog {
  id              Int      @id @default(autoincrement())
  orderId         Int?
  order           Order?   @relation(fields: [orderId], references: [id])
  requestPayload  String?  @map("request") @db.Text
  responsePayload String?  @map("response") @db.Text
  transactionRef  String?  @map("trans_ref_no")
  status          String?  @map("auth_status")
  loggedAt        DateTime @default(now())

  @@map("pg_request_response")
}

// ==========================================
// --- Analytics ---
// ==========================================

model AnalyticsEvent {
  id          Int          @id @default(autoincrement())
  platform    Platform
  appName     String?
  appVersion  String?
  userId      Int?
  user        User?        @relation(fields: [userId], references: [id])
  screenView  String
  userAction  String?
  ipAddress   String?
  contentType ContentType?
  contentId   Int?
  createdAt   DateTime     @default(now())

  @@map("analytics_data")
}

model AnalyticsJob {
  id             Int                @id @default(autoincrement())
  requestPayload String?            @map("request") @db.Text
  status         AnalyticsJobStatus @default(PENDING)
  requestedAt    DateTime           @default(now()) @map("request_time")
  processedAt    DateTime?

  @@index([status])
  @@map("analytics_request_data")
}

model WeeklyAnalyticsSummary {
  id                Int      @id @default(autoincrement())
  weekStartDate     DateTime
  weekEndDate       DateTime
  gaPageViewCount   Int
  gaUniqueVisitors  Int
  gaBounceRate      Float
  gaAvgTimeSpentSec Int      @map("ga_avg_time_spent")
  fbLikes           Int
  fbUnlikes         Int
  fbPostCount       Int
  fbPageViewCount   Int
  youtubeVideoViews Int
  createdAt         DateTime @default(now())

  @@map("analytics_data_weekly")
}

model MonthlyAnalyticsSummary {
  id                Int      @id @default(autoincrement())
  month             DateTime @unique
  gaPageViewCount   Int
  gaUniqueVisitors  Int
  gaBounceRate      Float
  gaAvgTimeSpentSec Int      @map("ga_avg_time_spent")
  fbLikes           Int
  fbUnlikes         Int
  fbPostCount       Int
  fbPageViewCount   Int
  youtubeVideoViews Int
  createdAt         DateTime @default(now())

  @@map("analytics_data_monthly")
}

// ==========================================
// --- Organizational Structure ---
// ==========================================

model Competency {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentId       Int?
  parent         Competency?  @relation("CompetencyHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Competency[] @relation("CompetencyHierarchy")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  courseLinks CourseCompetency[]

  @@map("competency")
}

model ProficiencyLevel {
  id             Int          @id @default(autoincrement())
  name           String       @map("proficiency")
  level          Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("competency_proficiency")
}

model CourseCompetency {
  courseId     Int
  course       Course     @relation(fields: [courseId], references: [id])
  competencyId Int
  competency   Competency @relation(fields: [competencyId], references: [id])
  points       Int?
  createdAt    DateTime   @default(now())

  @@id([courseId, competencyId])
  @@map("course_competency_map")
}

model OrgLevel {
  id             Int          @id @default(autoincrement())
  name           String       @map("level")
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentId       Int?
  parent         OrgLevel?    @relation("OrgLevelHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       OrgLevel[]   @relation("OrgLevelHierarchy")

  userOrgProfiles UserOrgProfile[]

  @@unique([organizationId, name])
  @@map("organisation_levels")
}

model Designation {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  userOrgProfiles UserOrgProfile[]

  @@unique([organizationId, name])
  @@map("organisation_designation")
}

model UserOrgProfile {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique
  user          User         @relation(fields: [userId], references: [id])
  divisionId    Int?
  division      Division?    @relation(fields: [divisionId], references: [id])
  departmentId  Int?
  department    Department?  @relation(fields: [departmentId], references: [id])
  levelId       Int?
  level         OrgLevel?    @relation(fields: [levelId], references: [id])
  designationId Int?
  designation   Designation? @relation(fields: [designationId], references: [id])
  joiningDate   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("users_tagging")
}

model LearningPath {
  id                  Int          @id @default(autoincrement())
  name                String
  description         String?
  imageUrl            String?
  organizationId      Int
  organization        Organization @relation(fields: [organizationId], references: [id])
  dueInDays           Int?
  isPublished         Boolean      @default(false)
  generateCertificate Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  prerequisites   LearningPathPrerequisite[]   @relation("mainPath")
  prerequisiteFor LearningPathPrerequisite[]   @relation("prerequisitePath")
  roleAssignments LearningPathRoleAssignment[]

  @@map("organisation_learning_path")
}

model LearningPathPrerequisite {
  pathId             Int
  path               LearningPath @relation("mainPath", fields: [pathId], references: [id])
  prerequisitePathId Int
  prerequisitePath   LearningPath @relation("prerequisitePath", fields: [prerequisitePathId], references: [id])

  @@id([pathId, prerequisitePathId])
  @@map("organisation_learning_path_requisites")
}

model LearningPathRoleAssignment {
  id             Int          @id @default(autoincrement())
  learningPathId Int
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id])
  roleId         Int
  role           Role         @relation(fields: [roleId], references: [id])
  divisionId     Int?
  division       Division?    @relation(fields: [divisionId], references: [id])

  @@unique([learningPathId, roleId, divisionId])
  @@map("organisation_learning_path_roles")
}

// ==========================================
// --- Platform Administration ---
// ==========================================

model Language {
  id         String  @id
  name       String  @unique
  nativeName String?

  @@map("language")
}

model Country {
  id      Int    @id @default(autoincrement())
  name    String @unique
  isoCode String @unique

  states State[]

  @@map("countries")
}

model State {
  id        Int     @id @default(autoincrement())
  name      String
  countryId Int
  country   Country @relation(fields: [countryId], references: [id])

  @@unique([countryId, name])
  @@map("states")
}

model FiscalYear {
  id        Int      @id @map("yearcd")
  startDate DateTime @map("yrfromdt")
  endDate   DateTime @map("yrtodt")
  name      String   @map("accyear")

  @@map("accyear")
}

model CronJob {
  id             Int           @id @default(autoincrement())
  title          String
  action         String
  frequency      CronFrequency
  lastRunAt      DateTime?
  nextRunAt      DateTime
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  courseId       Int?
  course         Course?       @relation(fields: [courseId], references: [id])
  paramsJson     Json?         @db.Json
  sendTo         String?
  sendCc         String?
  isInProcess    Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@map("cronjob_lookup")
}

model DashboardFeature {
  id   Int    @id @default(autoincrement())
  name String @unique @map("feature")

  assignments DashboardFeatureAssignment[]

  @@map("dashboard_features")
}

model DashboardFeatureAssignment {
  id             Int              @id @default(autoincrement())
  organizationId Int
  organization   Organization     @relation(fields: [organizationId], references: [id])
  featureId      Int
  feature        DashboardFeature @relation(fields: [featureId], references: [id])
  titleOverride  String?          @map("title")
  sequence       Int              @default(0)
  createdAt      DateTime         @default(now())

  @@unique([organizationId, featureId])
  @@map("dashboard_organisation_map")
}

// ==========================================
// --- Specialized & Legacy Modules ---
// ==========================================

// --- Facilitator & Batch Training ---
model Batch {
  id             Int          @id @default(autoincrement())
  name           String       @map("batch_name")
  description    String?
  courseId       Int
  course         Course       @relation(fields: [courseId], references: [id])
  facilitatorId  Int
  facilitator    User         @relation("BatchFacilitator", fields: [facilitatorId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         Status       @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members     BatchMember[]
  caseStudies BatchCaseStudy[]

  @@map("fac_batch")
}

model BatchMember {
  batchId  Int
  batch    Batch    @relation(fields: [batchId], references: [id])
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@id([batchId, userId])
  @@map("fac_batch_participants")
}

model BatchCaseStudy {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  videoUrl    String?
  batchId     Int
  batch       Batch    @relation(fields: [batchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions BatchCaseStudySubmission[]

  @@map("fac_casestudy")
}

model BatchCaseStudySubmission {
  id          Int            @id @default(autoincrement())
  caseStudyId Int
  caseStudy   BatchCaseStudy @relation(fields: [caseStudyId], references: [id])
  userId      Int
  user        User           @relation(fields: [userId], references: [id])
  notesTitle  String?
  notesBody   String?
  submittedAt DateTime       @default(now())

  @@map("fac_casestudy_users")
}

// --- SCORM Integration ---
model ScormPackage {
  id        Int      @id @default(autoincrement())
  name      String
  version   String
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  launchUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scorm")
}

// --- Resume Builder ---
model Resume {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id])
  fullName   String
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  objective  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workExperience ResumeWorkExperience[]
  education      ResumeEducation[]
  projects       ResumeProject[]
  skills         ResumeSkill[]

  @@map("resume_contact_details")
}

model ResumeWorkExperience {
  id               Int     @id @default(autoincrement())
  resumeId         Int
  resume           Resume  @relation(fields: [resumeId], references: [id])
  jobTitle         String  @map("job_role")
  company          String  @map("organisation")
  startDate        String  @map("from")
  endDate          String  @map("to")
  responsibilities String?

  @@map("resume_workex_details")
}

model ResumeEducation {
  id           Int    @id @default(autoincrement())
  resumeId     Int
  resume       Resume @relation(fields: [resumeId], references: [id])
  institution  String @map("institute_name")
  degree       String
  fieldOfStudy String @map("specialization")
  startDate    String @map("from")
  endDate      String @map("to")

  @@map("resume_education_details")
}

model ResumeProject {
  id          Int     @id @default(autoincrement())
  resumeId    Int
  resume      Resume  @relation(fields: [resumeId], references: [id])
  title       String  @map("project_title")
  description String?
  year        String

  @@map("resume_project_details")
}

model ResumeSkill {
  id       Int    @id @default(autoincrement())
  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id])
  skill    String @map("competency")

  @@map("resume_tech_skills")
}

// --- UDID & JICED Frameworks ---
model UdidRole {
  id        Int      @id @default(autoincrement()) @map("competency_role_id")
  name      String   @map("role")
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competencies UdidCompetency[]

  @@map("udid_roles")
}

model UdidCompetency {
  id          Int      @id @default(autoincrement())
  name        String   @map("competency")
  description String?
  roleId      Int
  role        UdidRole @relation(fields: [roleId], references: [id])

  @@map("udid_competency")
}

model JicedRole {
  id             Int          @id @default(autoincrement())
  name           String       @map("role")
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  candidates JicedCandidate[]

  @@map("jiced_roles")
}

model JicedCandidate {
  id             Int          @id @default(autoincrement())
  name           String       @map("candidate")
  roleId         Int
  role           JicedRole    @relation(fields: [roleId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("jiced_candidates")
}

// --- Other User-Related Models ---
model CourseEnrollment {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  courseId        Int
  course          Course    @relation(fields: [courseId], references: [id])
  pointsAchieved  Int       @default(0)
  percentComplete Int       @default(0)
  isStarted       Boolean   @default(false)
  startedAt       DateTime?
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, courseId])
  @@map("courses_users")
}

model ClipProgress {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  clipId          Int
  clip            Clip      @relation(fields: [clipId], references: [id])
  pointsAchieved  Int       @default(0)
  percentComplete Int       @default(0)
  isStarted       Boolean   @default(false)
  startedAt       DateTime?
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, clipId])
  @@map("clips_users")
}

model DocumentUser {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  documentId Int
  document   Document @relation(fields: [documentId], references: [id])
  isViewed   Boolean  @default(false)
  rating     Int? // e.g., 1-5 stars

  @@unique([userId, documentId])
  @@map("documents_users")
}

// --- Microlms (Legacy Module) ---
model MicrolmsFeature {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  slug        String? @map("url_slug")
  icon        String? @map("icons")

  organizationAssignments MicrolmsFeatureOrgAssignment[]

  @@map("microlms_features")
}

model MicrolmsFeatureOrgAssignment {
  id             Int             @id @default(autoincrement())
  featureId      Int
  feature        MicrolmsFeature @relation(fields: [featureId], references: [id])
  organizationId Int
  organization   Organization    @relation(fields: [organizationId], references: [id])
  sequence       Int             @default(0)
  titleOverride  String?
  level          Int             @default(0)

  @@map("microlms_features_org_map")
}

model MicrolmsContent {
  id             Int          @id @default(autoincrement())
  title          String?
  description    String?
  type           String? // e.g., 'VIDEO', 'PDF'
  subtype        String?
  sequence       Int?
  tags           String?
  thumbnailUrl   String?      @map("thumbnail")
  url            String?
  status         Status       @default(ACTIVE)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  userStatuses MicrolmsContentUserStatus[]

  @@map("microlms_learning_content")
}

model MicrolmsContentUserStatus {
  id        Int             @id @default(autoincrement())
  contentId Int
  content   MicrolmsContent @relation(fields: [contentId], references: [id])
  userId    Int
  user      User            @relation(fields: [userId], references: [id])
  status    Status          @default(ACTIVE)
  createdAt DateTime        @default(now())

  @@unique([contentId, userId])
  @@map("microlms_learningcontent_user_status")
}

model MicrolmsQuiz {
  id                     Int          @id @default(autoincrement())
  title                  String?
  description            String?
  timerInMinutes         Int          @default(0) @map("timer")
  hasSubjectiveQuestions Boolean      @default(false)
  showAnalysis           Boolean      @default(true)
  showCorrectOption      Boolean      @default(true)
  status                 Status       @default(ACTIVE)
  organizationId         Int
  organization           Organization @relation(fields: [organizationId], references: [id])

  questions MicrolmsQuizQuestionLink[]
  attempts  MicrolmsQuizAttempt[]

  @@map("microlms_quiz_master")
}

model MicrolmsQuestion {
  id             Int          @id @default(autoincrement())
  text           String?      @map("question")
  type           String? // e.g., 'MULTIPLE_CHOICE'
  points         Float        @default(1)
  sequence       Int          @default(0)
  status         Status       @default(ACTIVE)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  options   MicrolmsQuestionOption[]
  quizLinks MicrolmsQuizQuestionLink[]

  @@map("microlms_questions_master")
}

model MicrolmsQuestionOption {
  id         Int              @id @default(autoincrement())
  label      String?
  value      String?
  isCorrect  Boolean          @default(false)
  sequence   Int              @default(0) @map("order")
  questionId Int
  question   MicrolmsQuestion @relation(fields: [questionId], references: [id])

  @@map("microlms_quiz_options")
}

model MicrolmsQuizQuestionLink {
  quizId     Int
  quiz       MicrolmsQuiz     @relation(fields: [quizId], references: [id])
  questionId Int
  question   MicrolmsQuestion @relation(fields: [questionId], references: [id])
  sequence   Int              @default(0) @map("order")

  @@id([quizId, questionId])
  @@map("microlms_quiz_questions_map")
}

model MicrolmsQuizAttempt {
  id          Int          @id @default(autoincrement())
  quizId      Int
  quiz        MicrolmsQuiz @relation(fields: [quizId], references: [id])
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  isStarted   Boolean      @default(false)
  isCompleted Boolean      @default(false)
  startedAt   DateTime?    @map("starttime")
  completedAt DateTime?    @map("endtime")

  @@unique([quizId, userId])
  @@map("microlms_quiz_user_status")
}

model MicrolmsCalendarEvent {
  id        Int      @id @default(autoincrement())
  title     String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  startDate String
  endDate   String
  startTime String
  endTime   String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())

  @@map("microlms_calendar")
}

model MicrolmsProductCategory {
  id             Int                       @id @default(autoincrement())
  name           String                    @map("category")
  organizationId Int
  organization   Organization              @relation(fields: [organizationId], references: [id])
  parentId       Int?                      @map("parent")
  parent         MicrolmsProductCategory?  @relation("MicrolmsCategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       MicrolmsProductCategory[] @relation("MicrolmsCategoryHierarchy")
  status         Status                    @default(ACTIVE)

  @@map("microlms_product_categories")
}

model IncentiveKpi {
  id          Int     @id @default(autoincrement())
  year        Int
  month       Int
  name        String  @map("kpi")
  description String
  sortOrder   Int
  isPriority  Boolean
  status      Status  @default(ACTIVE)

  userIncentives UserIncentive[]

  @@map("rb_incentive_master")
}

model UserIncentive {
  id                   Int          @id @default(autoincrement())
  kpiId                Int
  kpi                  IncentiveKpi @relation(fields: [kpiId], references: [id])
  userId               Int
  user                 User         @relation(fields: [userId], references: [id])
  target               String
  achieved             String
  achievedPercent      String
  totalAchievedPercent String
  incentiveAmount      String       @map("incentive")
  createdAt            DateTime     @default(now())

  @@map("rb_incentive_users")
}
