{
  "name": "jwt-auth-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend API with JWT authentication, refresh tokens, multi-tenancy, and internationalization",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/seed.js",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nodejs",
    "fastify",
    "jwt",
    "authentication",
    "multi-tenancy",
    "prisma",
    "postgresql",
    "i18n"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^9.2.0",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@prisma/client": "^5.7.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "fastify-swagger": "^5.1.1",
    "i18next": "^23.7.6",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "mermaid": "^11.11.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^5.7.1",
    "prisma-erd-generator": "^2.1.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
