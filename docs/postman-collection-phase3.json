{
  "info": {
    "name": "Learning Management System - Phase 3 APIs",
    "description": "Complete API collection for Course Enrollment and Progress Tracking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "enrollment_id",
      "value": "",
      "type": "string",
      "description": "Store enrollment ID from create response"
    }
  ],
  "item": [
    {
      "name": "Course Enrollments",
      "item": [
        {
          "name": "Enroll in Course",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.enrollment) {",
                  "        pm.collectionVariables.set('enrollment_id', response.data.enrollment.id);",
                  "        console.log('Enrollment ID saved:', response.data.enrollment.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/enrollments/courses/1",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "courses", "1"]
            },
            "description": "Enroll the current user in a course. Returns enrollment details and automatically saves enrollment_id for subsequent requests."
          },
          "response": []
        },
        {
          "name": "Get My Enrollments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/enrollments/my?page=1&limit=20&isCompleted=false&sortBy=enrolledAt&sortOrder=desc",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "my"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (max 100)"
                },
                {
                  "key": "isCompleted",
                  "value": "false",
                  "description": "Filter by completion status"
                },
                {
                  "key": "sortBy",
                  "value": "enrolledAt",
                  "description": "Sort field: enrolledAt, updatedAt, percentComplete"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "Sort order: asc, desc"
                }
              ]
            },
            "description": "Get all courses the current user is enrolled in with pagination and filtering."
          },
          "response": []
        },
        {
          "name": "Get Course Enrollments (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/enrollments/courses/1?page=1&limit=20&isCompleted=false",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "courses", "1"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "isCompleted",
                  "value": "false",
                  "description": "Filter by completion status"
                },
                {
                  "key": "sortBy",
                  "value": "enrolledAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            },
            "description": "Admin endpoint to view all users enrolled in a specific course."
          },
          "response": []
        },
        {
          "name": "Get Enrollment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/enrollments/{{enrollment_id}}",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "{{enrollment_id}}"]
            },
            "description": "Get detailed information about a specific enrollment."
          },
          "response": []
        },
        {
          "name": "Update Enrollment Progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progressPercent\": 50,\n  \"pointsEarned\": 75,\n  \"isCompleted\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/enrollments/{{enrollment_id}}/progress",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "{{enrollment_id}}", "progress"]
            },
            "description": "Update the progress of an enrollment. All fields are optional."
          },
          "response": []
        },
        {
          "name": "Complete Enrollment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progressPercent\": 100,\n  \"pointsEarned\": 150,\n  \"isCompleted\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/enrollments/{{enrollment_id}}/progress",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "{{enrollment_id}}", "progress"]
            },
            "description": "Mark an enrollment as completed with final progress and points."
          },
          "response": []
        },
        {
          "name": "Unenroll from Course",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/enrollments/{{enrollment_id}}",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "{{enrollment_id}}"]
            },
            "description": "Remove enrollment from a course (hard delete)."
          },
          "response": []
        },
        {
          "name": "Get Enrollment Statistics (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/enrollments/courses/1/stats",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "courses", "1", "stats"]
            },
            "description": "Get enrollment statistics for a course including total enrollments, completion rate, and average progress."
          },
          "response": []
        }
      ],
      "description": "Course enrollment management endpoints for enrolling users, tracking enrollment progress, and viewing enrollment statistics."
    },
