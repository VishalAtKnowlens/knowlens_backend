              "path": ["progress", "my"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "courseId",
                  "value": "1",
                  "description": "Filter by course ID"
                },
                {
                  "key": "isCompleted",
                  "value": "false",
                  "description": "Filter by completion status"
                },
                {
                  "key": "sortBy",
                  "value": "updatedAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            },
            "description": "Get all clip progress for the current user with optional course filter."
          },
          "response": []
        },
        {
          "name": "Get Clip Progress for All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/clips/1?page=1&limit=20&isCompleted=false",
              "host": ["{{base_url}}"],
              "path": ["progress", "clips", "1"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "isCompleted",
                  "value": "false"
                },
                {
                  "key": "sortBy",
                  "value": "updatedAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            },
            "description": "Admin endpoint to view all users' progress for a specific clip."
          },
          "response": []
        },
        {
          "name": "Get My Progress for Specific Clip",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/clips/1/my",
              "host": ["{{base_url}}"],
              "path": ["progress", "clips", "1", "my"]
            },
            "description": "Get the current user's progress for a specific clip."
          },
          "response": []
        },
        {
          "name": "Get Clip Statistics (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/clips/1/stats",
              "host": ["{{base_url}}"],
              "path": ["progress", "clips", "1", "stats"]
            },
            "description": "Get clip statistics including total users, completion rate, and average progress."
          },
          "response": []
        },
        {
          "name": "Get Course Progress Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/courses/1/summary",
              "host": ["{{base_url}}"],
              "path": ["progress", "courses", "1", "summary"]
            },
            "description": "Get comprehensive progress summary for a course including all clips, completion status, and points earned."
          },
          "response": []
        }
      ],
      "description": "Clip progress tracking endpoints for monitoring user progress through course content."
    },
