// THIS IS THE MERGED SCHEMA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// From schema.prisma (with fixes)

model Organisation {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
    settings  Json?
  language    String   @default("en")
  isActive    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  roles       Role[]
  users          User[]
  courses        Course[]
  learningPaths  LearningPath[]
  mediaAssets    MediaAsset[]
  quizzes        Quiz[]
  announcements  Announcement[]
  faqs           Faq[]
  competencyFrameworks CompetencyFramework[]

  @@map("organisations")
}

model User {
  id                String    @id @default(uuid())
  organisationId    String
  firstName         String
  lastName          String
  email             String    @unique
  password          String
  language          String    @default("en")
  emailVerified     Boolean   @default(false)
  employeeId        String?
  profilePictureUrl String?
  role              String? // Added back as optional
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  refreshTokens  RefreshToken[]

  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userRoles         UserRole[]
  enrollments       Enrollment[]
  quizAttempts      QuizAttempt[]
  certificates      Certificate[]
  discussionPosts   Discussion[]
  discussionComments DiscussionComment[]
  assignmentSubmissions UserAssignmentSubmission[]
  resume            Resume?

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions Json     // Store permissions as JSON array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Relations
  userRoles    UserRole[]

  @@unique([name, organisationId])
  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  deviceInfo String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// From analytics.prisma

/// Tracks user login and session history.
model LoginHistory {
  id        String      @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  status    LoginStatus
  createdAt DateTime    @default(now())

  @@map("login_history")
}

enum LoginStatus {
  SUCCESS
  FAILURE
}

/// A generic log for tracking important events and changes in the system.
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  // User who performed the action. Can be null for system actions.
  organisationId String
  action       String   // e.g., "COURSE_CREATED", "USER_DELETED"
  targetType   String?  // The model that was affected, e.g., "Course"
  targetId     String?
    details      Json? // Can store before/after state of the data
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

// From assessment.prisma

/// A quiz is a collection of questions used for assessment.
model Quiz {
  id                  String   @id @default(uuid())
  organisationId      String
  title               String
  description         String?
  passingScore        Float    @default(70.0)
  timeLimitMinutes    Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  questions           Question[]
  attempts            QuizAttempt[]
  
  @@map("quizzes")
}

/// A single question within a quiz.
model Question {
  id            String          @id @default(uuid())
  quizId        String
  questionText  String
  questionType  String          // 'multiple-choice', 'true-false', 'essay'
  sequence      Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  quiz          Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options       QuestionOption[]
  userAnswers   UserAnswer[]
  
  @@map("questions")
}

/// An option for a multiple-choice question.
model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  optionText  String
  isCorrect   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@map("question_options")
}

/// A record of a user's attempt to complete a quiz.
model QuizAttempt {
  id           String       @id @default(uuid())
  enrollmentId String
  quizId       String
  score        Float?
  status       String       // 'in-progress', 'completed', 'passed', 'failed'
  startedAt    DateTime     @default(now())
  completedAt  DateTime?

  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      UserAnswer[]
  user         User         @relation(fields: [userId], references: [id])
  userId       String

  @@map("quiz_attempts")
}

/// A user's specific answer to a question within an attempt.
model UserAnswer {
  id                 String          @id @default(uuid())
  attemptId          String
  questionId         String
  selectedOptionId   String?
  answerText         String?
  isCorrect          Boolean?

  attempt            QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question           Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@map("user_answers")
}

// From community.prisma

/// Organisation-wide announcements.
model Announcement {
  id             String       @id @default(uuid())
  organisationId String
  title          String
  content        String
  isPublished    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  
  @@map("announcements")
}

/// FAQs for an organisation.
model Faq {
  id             String       @id @default(uuid())
  organisationId String
  question       String
  answer         String
  category       String?
  sequence       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  
  @@map("faqs")
}

/// A discussion thread, typically associated with a course.
model Discussion {
  id        String              @id @default(uuid())
  courseId  String
  userId    String
  title     String
  body      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  DiscussionComment[]
  
  @@map("discussions")
}

/// A comment within a discussion thread, supports nesting.
model DiscussionComment {
  id              String             @id @default(uuid())
  discussionId    String
  userId          String
  parentCommentId String?
  body            String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  discussion      Discussion         @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment   DiscussionComment? @relation("Thread", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         DiscussionComment[]@relation("Thread")
  
  @@map("discussion_comments")
}

// From competency.prisma

/// A container for a set of related competencies.
model CompetencyFramework {
  id             String       @id @default(uuid())
  organisationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competencies   Competency[]

  @@map("competency_frameworks")
}

/// An individual skill or competency within a framework.
model Competency {
  id           String        @id @default(uuid())
  frameworkId  String
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  framework    CompetencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  
  @@map("competencies")
}

// From ecommerce.prisma

/// Represents a sellable item, which could be a course, learning path, or a bundle.
model Product {
  id           String    @id @default(uuid())
  productId    String    // The ID of the Course or LearningPath
  productType  String    // "COURSE" or "LEARNING_PATH"
  name         String
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prices       Price[]
  orderItems   OrderItem[]

  @@unique([productId, productType])
  @@map("products")
}

/// Defines the price for a product, allowing for different currencies or plans.
model Price {
  id           String    @id @default(uuid())
  productId    String
  amount       Float
  currency     String    @default("USD")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  product      Product   @relation(fields: [productId], references: [id])
  
  @@map("prices")
}

/// Represents a discount coupon.
model Coupon {
  id              String     @id @default(uuid())
  code            String     @unique
  discountPercent Float
  maxUses         Int?
  validUntil      DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())

  orders          Order[]

  @@map("coupons")
}

/// A record of a user's purchase.
model Order {
  id            String         @id @default(uuid())
  userId        String
  couponId      String?
  totalAmount   Float
  finalAmount   Float
  status        String         // "PENDING", "COMPLETED", "FAILED"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  coupon        Coupon?        @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  transactions  Transaction[]

  @@map("orders")
}

/// A line item within an order.
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  price     Float
  quantity  Int      @default(1)

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

/// Logs payment gateway requests and responses.
model Transaction {
  id                  String   @id @default(uuid())
  orderId             String
  gateway             String   // "Stripe", "PayPal", etc.
  gatewayTransactionId String?
  amount              Float
  status              String   // "INITIATED", "SUCCESS", "FAILURE"
  requestPayload      Json?
  responsePayload     Json?
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id])
  
  @@map("transactions")
}

// From gamification.prisma

/// Defines an achievable badge, its appearance, and the criteria for earning it.
model Badge {
  id             String    @id @default(uuid())
  organisationId String?   // Null for system-wide badges, filled for org-specific ones
  name           String
  description    String
  iconUrl        String
  criteria       Json      @db.JsonB // Flexible rules, e.g., { "type": "COURSE_COMPLETION", "courseId": "..." }
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  awardedBadges  UserBadge[]

  @@map("badges")
}

/// A record of a user being awarded a specific badge.
model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  // We are not using a direct relation to User here to keep this module decoupled.
  // The userId can be used to query the User model from the core module.
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// From learning.prisma

/// A course is a collection of modules and content.
model Course {
  id              String      @id @default(uuid())
  organisationId  String
  title           String
  slug            String
  description     String?
  thumbnailUrl    String?
  isPublished     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  modules         Module[]
  enrollments     Enrollment[]
  discussions     Discussion[]
  learningPaths   LearningPathCourse[]

  @@unique([organisationId, slug])
  @@map("courses")
}

/// A structured sequence of courses.
model LearningPath {
  id              String      @id @default(uuid())
  organisationId  String
  title           String
  description     String?
  isPublished     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  courses         LearningPathCourse[]

  @@map("learning_paths")
}

/// Junction table for courses within a learning path.
model LearningPathCourse {
  learningPathId String
  courseId      String
  sequence      Int

  learningPath  LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([learningPathId, courseId])
  @@map("learning_path_courses")
}

/// A module is a section within a course (formerly 'clip').
model Module {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  sequence  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentItems  ContentItem[]

  @@map("modules")
}

/// An individual piece of learning content within a module.
model ContentItem {
  id          String        @id @default(uuid())
  moduleId    String
  title       String
  contentType ContentType   // Enum defining the type of content
  assetId     String        // Polymorphic foreign key
  sequence    Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    Progress[]

  @@map("content_items")
}

enum ContentType {
  VIDEO
  DOCUMENT
  QUIZ
  ASSIGNMENT
  SCORM
}

/// Tracks a user's enrollment and overall progress in a course.
model Enrollment {
  id           String        @id @default(uuid())
  userId       String
  courseId     String
  status       String        @default("enrolled") // 'enrolled', 'in-progress', 'completed'
  progress     Int           @default(0) // Percentage
  completedAt  DateTime?
  enrolledAt   DateTime      @default(now())
  
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressItems Progress[]
  quizAttempts  QuizAttempt[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

/// Tracks a user's progress on a specific content item.
model Progress {
  id            String    @id @default(uuid())
  enrollmentId  String
  contentItemId String
  status        String    @default("not-started") // 'not-started', 'in-progress', 'completed'
  score         Float?
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, contentItemId])
  @@map("progress")
}

/// Represents an assignment that requires a submission.
model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  submissions UserAssignmentSubmission[]

  @@map("assignments")
}

/// Stores a user's submission for an assignment.
model UserAssignmentSubmission {
  id              String      @id @default(uuid())
  assignmentId    String
  userId          String
  submissionUrl   String?     // URL to the submitted file
  submissionText  String?
  grade           Float?
  feedback        String?
  submittedAt     DateTime    @default(now())

  assignment      Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_assignment_submissions")
}

/// Stores certificates awarded to users.
model Certificate {
  id              String        @id @default(uuid())
  userId          String
  courseId        String?
  learningPathId  String?
  certificateUrl  String
  issuedAt        DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("certificates")
}

// From marketing.prisma

/// Tracks incoming traffic from marketing campaigns.
model Campaign {
  id        String   @id @default(uuid())
  name      String   // e.g., "Summer_Sale_2025"
  source    String?  // utm_source
  medium    String?  // utm_medium
  term      String?  // utm_term
  content   String?  // utm_content
  createdAt DateTime @default(now())

  referrals Referral[]

  @@map("campaigns")
}

/// Tracks a referral from one user to another.
model Referral {
  id             String    @id @default(uuid())
  campaignId     String?
  referrerUserId String
  refereeEmail   String
  refereeName    String?
  status         String    // "SENT", "REGISTERED", "COMPLETED_PURCHASE"
  referralCode   String    @unique
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  
  @@map("referrals")
}

// From media.prisma

/// A central repository for all media files (videos, PDFs, images, etc.).
model MediaAsset {
  id             String    @id @default(uuid())
  organisationId String
  fileName       String
  fileType       String    // 'video', 'image', 'pdf', 'audio'
  mimeType       String
  fileSizeKb     Int
  storagePath    String    // e.g., S3 key
  metadata       Json?     @db.JsonB // video duration, image dimensions, etc.
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  subtitles      VideoSubtitle[]

  @@map("media_assets")
}

/// Subtitles for video assets.
model VideoSubtitle {
  id          String   @id @default(uuid())
  mediaAssetId String
  languageCode String  // 'en', 'es', 'hi'
  subtitleUrl String
  createdAt   DateTime @default(now())

  mediaAsset  MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("video_subtitles")
}

// From resume.prisma

/// The main resume document for a user.
model Resume {
  id        String   @id @default(uuid())
  userId    String   @unique // A user has only one resume
  fullName  String
  email     String
  phone     String?
  address   String?
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Relationships to different sections of the resume
  workExperiences WorkExperience[]
  educations      Education[]
  projects        Project[]
  skills          Skill[]

  @@map("resumes")
}

/// A single work experience entry in a resume.
model WorkExperience {
  id               String    @id @default(uuid())
  resumeId         String
  jobTitle         String
  companyName      String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  responsibilities String?
  sequence         Int       @default(0)

  resume           Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

/// A single education entry in a resume.
model Education {
  id              String    @id @default(uuid())
  resumeId        String
  institutionName String
  degree          String
  fieldOfStudy    String?
  startDate       DateTime
  endDate         DateTime?
  grade           String?
  sequence        Int       @default(0)

  resume          Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("educations")
}

/// A project entry in a resume.
model Project {
  id           String   @id @default(uuid())
  resumeId     String
  projectName  String
  description  String?
  role         String?
  sequence     Int      @default(0)
  
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("projects")
}

/// A skill entry in a resume.
model Skill {
  id         String   @id @default(uuid())
  resumeId   String
  skillName  String
  skillLevel String? // e.g., 'Beginner', 'Intermediate', 'Expert'
  sequence   Int      @default(0)

  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("skills")
}

// From training.prisma

/// A scheduled training event, either virtual or in-person.
model TrainingSession {
  id                 String             @id @default(uuid())
  organisationId     String
  courseId           String?            // Optional link to a self-paced course
  title              String
  description        String?
  trainingType       String             // "VIRTUAL", "IN_PERSON"
  startTime          DateTime
  endTime            DateTime
  locationOrUrl      String
  trainerId          String?            // The user ID of the trainer
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  batches            Batch[]

  @@map("training_sessions")
}

/// A specific group of users attending a training session.
model Batch {
  id                String            @id @default(uuid())
  trainingSessionId String
  name              String
  maxCapacity       Int?
  createdAt         DateTime          @default(now())

  trainingSession   TrainingSession   @relation(fields: [trainingSessionId], references: [id])
  enrollments       BatchEnrollment[]

  @@map("batches")
}

/// Connects a user to a specific training batch.
model BatchEnrollment {
  id        String      @id @default(uuid())
  batchId   String
  userId    String
  attended  Boolean?    // Null until marked
  createdAt DateTime    @default(now())

  batch     Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // user relation is implicit via userId

  @@unique([batchId, userId])
  @@map("batch_enrollments")
}

// From utilities.prisma

/// A generic, polymorphic tagging system.
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  taggings  Tagging[]

  @@map("tags")
}

/// Junction table to apply tags to different types of content.
model Tagging {
  id         String   @id @default(uuid())
  tagId      String
  targetId   String   // ID of the item being tagged (e.g., Course, MediaAsset)
  targetType String   // "COURSE", "MEDIA_ASSET", etc.

  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, targetId, targetType])
  @@map("taggings")
}

/// Stores country data.
model Country {
  id        Int      @id @default(autoincrement())
  name      String
  sortName  String   @map("sort_name") // e.g., "US"
  
  states    State[]

  @@map("countries")
}

/// Stores state/province data, linked to a country.
model State {
  id        Int      @id @default(autoincrement())
  countryId Int
  name      String

  country   Country  @relation(fields: [countryId], references: [id])
  cities    City[]
  
  @@map("states")
}

/// Stores city data, linked to a state.
model City {
  id      Int    @id @default(autoincrement())
  stateId Int
  name    String

  state   State  @relation(fields: [stateId], references: [id])

  @@map("cities")
}

/// API tokens for third-party integrations or system services.
model ApiToken {
  id          String    @id @default(uuid())
  userId      String    // The user or service account this token belongs to
  tokenHash   String    @unique
  name        String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_tokens")
}

/// Stores system-wide or organisation-specific settings.
model Setting {
  id             String   @id @default(uuid())
  organisationId String?  // Null for system-wide settings
  key            String   // e.g., "ENABLE_PUBLIC_REGISTRATION"
  value          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organisationId, key])
